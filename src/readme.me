# TickerAll MT5 брокер холболт үүсгэх
araatan session

# Health check (Тохиргоо, GGUF, TickerAll API шалгах)
araatan check

# Model conversion (HF → GGUF Q8_0)
araatan convert --model chronos-2 --quant Q8_0 --out models/chronos-2-Q8_0.gguf

# GGUF metadata
araatan gguf-info --model models/tabicl-Q8_0.gguf

# Backtest (M5 bars)
araatan backtest --from 2025-01-01 --to 2025-06-30

# Live inference runner
araatan live
